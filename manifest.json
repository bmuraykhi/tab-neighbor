{
  "manifest_version": 3,
  "name": "Tab Neighbor",
  "version": "1.0.0",
  "description": "Opens every new tab immediately to the right of the active tab instead of at the end of the tab strip.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
